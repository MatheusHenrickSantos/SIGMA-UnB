# Copie para .env e ajuste se precisar. Sem .env, o compose usa estes mesmos valores.
POSTGRES_DB=sigma
POSTGRES_USER=sigma
POSTGRES_PASSWORD=sigma
# Troque se já houver um Postgres rodando na 5432 da sua máquina.
POSTGRES_PORT=5432

# MinIO (data lake). A senha precisa ter pelo menos 8 caracteres.
MINIO_USER=sigma
MINIO_PASSWORD=sigma12345
# Troque se as portas 9000/9001 já estiverem em uso.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
