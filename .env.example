# Copie para .env e ajuste se precisar. Sem .env, o compose usa estes mesmos valores.
HOST_DO_BANCO=localhost
# Troque se já houver um Postgres rodando na 5432 da sua máquina.
PORTA_DO_BANCO=5432
NOME_DO_BANCO=sigma
USUARIO_DO_BANCO=sigma
SENHA_DO_BANCO=sigma
# Ingestão: limite de páginas do catálogo CATMAT (500 itens por página).
# Vazio = catálogo inteiro (centenas de páginas, demora). Ex.: 5 para um teste rápido.
CATMAT_MAX_PAGINAS=

# Busca semântica (serviço semantica; ver docs/semantica.md)
SEMANTICA_MODELO=intfloat/multilingual-e5-small
# Commit do modelo no Hugging Face. Vazio = versão mais recente (o commit usado fica registrado no banco).
SEMANTICA_REVISAO=
# Candidatos CATMAT guardados por material.
SEMANTICA_TOP_K=10
# Similaridade mínima (cosseno) para guardar um candidato. Vazio = sem filtro.
# Não há valor calibrado: escolha olhando pares já revisados.
SEMANTICA_LIMIAR=
# 1 = proíbe índice HNSW, se um dia for criado. Hoje não há índice e a busca já é exata (ADR 0005).
SEMANTICA_BUSCA_EXATA=
